#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS GITHUB TOOLS AUDITOR
# Objectif : Vérifier si les outils de sécurité GitHub sont réels ou fake.
# Auteur   : Aissa Mohammedi (DGK) - NEXUS-OPEN-3.0
# ═══════════════════════════════════════════════════════════════════════════════

set -uo pipefail

TOKEN="${GITHUB_TOKEN:-}"
API="https://api.github.com"
TOTAL=0
PASSED=0

# Couleurs
G='\033[1;32m'; R='\033[1;31m'; Y='\033[1;33m'; C='\033[1;36m'; M='\033[1;35m'; N='\033[0m'

if [[ -z "$TOKEN" ]]; then
    echo -e "${Y}[!] Pas de GITHUB_TOKEN. Certaines APIs seront limitées.${N}"
    AUTH=""
else
    AUTH="Authorization: Bearer $TOKEN"
fi

echo -e "${M}╔══════════════════════════════════════════════════════════════════════╗${N}"
echo -e "${M}║   NEXUS GITHUB TOOLS AUDITOR - LES OUTILS SONT-ILS FAKE ?           ║${N}"
echo -e "${M}╚══════════════════════════════════════════════════════════════════════╝${N}"

# ═══════════════════════════════════════════════════════════════════════════════
# TEST 1 : CODEQL - Est-ce que l'API expose les langages supportés ?
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${C}▸ [1/5] CODEQL (Code Scanning)${N}"
echo -e "───────────────────────────────────────────────────────────────"

# On demande à l'API les langages supportés par CodeQL
# Si l'API retourne une liste, c'est réel. Si elle retourne null/erreur, c'est fake.
TOTAL=$((TOTAL+1))
CODEQL_RESPONSE=$(curl -s -H "$AUTH" -H "Accept: application/vnd.github+json" \
    "$API/repos/Aissamohammedi88/NEXUS-OMEGA-SWARM/code-scanning/alerts" 2>/dev/null)

# Même si le dépôt n'a pas d'alertes, l'API doit répondre avec un tableau vide (200) et non 404/500
HTTP_CODE=$(echo "$CODEQL_RESPONSE" | tail -n1 2>/dev/null)
# Vérifier si la réponse est un JSON valide
if echo "$CODEQL_RESPONSE" | jq -e 'type == "array" or .message' >/dev/null 2>&1; then
    echo -e "  ${G}[OK]${N} L'endpoint CodeQL existe et répond (JSON valide)."
    PASSED=$((PASSED+1))
else
    echo -e "  ${R}[FAIL]${N} L'endpoint CodeQL ne répond pas correctement."
    echo -e "  ${Y}    Réponse brute : $(echo "$CODEQL_RESPONSE" | head -c 200)${N}"
fi

# Vérifier les langages supportés via la doc (hardcodé mais vérifiable)
# On teste si le langage Python est supporté (c'est documenté)
TOTAL=$((TOTAL+1))
CODEQL_LANG_CHECK=$(curl -s -H "$AUTH" "$API/repos/Aissamohammedi88/NEXUS-OMEGA-SWARM/code-scanning/default-setup" 2>/dev/null)
if echo "$CODEQL_LANG_CHECK" | jq -e '.languages' >/dev/null 2>&1; then
    LANGS=$(echo "$CODEQL_LANG_CHECK" | jq -r '.languages | join(", ")')
    echo -e "  ${G}[OK]${N} Langages détectés par CodeQL : $LANGS"
    PASSED=$((PASSED+1))
else
    echo -e "  ${Y}[WARN]${N} Impossible de lire les langages (dépôt peut-être vide)."
fi

# ═══════════════════════════════════════════════════════════════════════════════
# TEST 2 : SECRET SCANNING - Est-ce que l'API expose les patterns ?
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${C}▸ [2/5] SECRET SCANNING${N}"
echo -e "───────────────────────────────────────────────────────────────"

TOTAL=$((TOTAL+1))
SECRET_RESPONSE=$(curl -s -H "$AUTH" -H "Accept: application/vnd.github+json" \
    "$API/repos/Aissamohammedi88/NEXUS-OMEGA-SWARM/secret-scanning/alerts" 2>/dev/null)

if echo "$SECRET_RESPONSE" | jq -e 'type == "array" or .message' >/dev/null 2>&1; then
    echo -e "  ${G}[OK]${N} L'endpoint Secret Scanning existe et répond."
    PASSED=$((PASSED+1))
else
    echo -e "  ${R}[FAIL]${N} L'endpoint Secret Scanning ne répond pas correctement."
fi

# Vérifier si l'API expose les patterns (via la doc GitHub)
# On teste si le endpoint /secret-scanning/patterns existe (c'est une API de doc)
TOTAL=$((TOTAL+1))
PATTERN_RESPONSE=$(curl -s -H "$AUTH" "$API/secret-scanning/patterns" 2>/dev/null)
if echo "$PATTERN_RESPONSE" | jq -e 'type == "array"' >/dev/null 2>&1; then
    PATTERN_COUNT=$(echo "$PATTERN_RESPONSE" | jq 'length')
    echo -e "  ${G}[OK]${N} L'API expose $PATTERN_COUNT patterns de secrets. C'est réel."
    PASSED=$((PASSED+1))
else
    echo -e "  ${Y}[WARN]${N} L'endpoint des patterns n'est pas accessible (normal si pas GHAS)."
fi

# ═══════════════════════════════════════════════════════════════════════════════
# TEST 3 : DEPENDABOT - Est-ce que l'API expose les alertes ?
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${C}▸ [3/5] DEPENDABOT${N}"
echo -e "───────────────────────────────────────────────────────────────"

TOTAL=$((TOTAL+1))
DEP_RESPONSE=$(curl -s -H "$AUTH" -H "Accept: application/vnd.github+json" \
    "$API/repos/Aissamohammedi88/NEXUS-OMEGA-SWARM/dependabot/alerts" 2>/dev/null)

if echo "$DEP_RESPONSE" | jq -e 'type == "array" or .message' >/dev/null 2>&1; then
    echo -e "  ${G}[OK]${N} L'endpoint Dependabot existe et répond."
    PASSED=$((PASSED+1))
else
    echo -e "  ${R}[FAIL]${N} L'endpoint Dependabot ne répond pas correctement."
fi

# ═══════════════════════════════════════════════════════════════════════════════
# TEST 4 : COHÉRENCE - Ce que la doc dit vs ce que l'API retourne
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${C}▸ [4/5] COHÉRENCE DOCUMENTATION vs API${N}"
echo -e "───────────────────────────────────────────────────────────────"

# Test : La doc GitHub dit que CodeQL supporte Python, C++, Java, etc.
# On vérifie que l'API de default-setup retourne bien ces langages pour un dépôt Python.
TOTAL=$((TOTAL+1))
# Créer un test avec un fichier Python dans le dépôt (via l'API)
TEST_PY='print("test")'
PY_B64=$(echo "$TEST_PY" | base64 -w 0)
# On ne crée pas de fichier, on vérifie juste que l'API CodeQL peut analyser un fichier Python
# Si l'API est fake, elle ne saura pas détecter Python.
# On interroge la doc officielle (via l'API) pour vérifier que Python est listé.
# En réalité, on teste l'endpoint /languages de CodeQL (s'il existe).
LANG_RESPONSE=$(curl -s -H "$AUTH" "$API/repos/Aissamohammedi88/NEXUS-OMEGA-SWARM/code-scanning/default-setup" 2>/dev/null)
if echo "$LANG_RESPONSE" | jq -e '.languages | index("python")' >/dev/null 2>&1; then
    echo -e "  ${G}[OK]${N} CodeQL détecte Python. L'outil est réel."
    PASSED=$((PASSED+1))
else
    echo -e "  ${Y}[WARN]${N} CodeQL ne détecte pas Python sur ce dépôt (peut-être vide)."
fi

# ═══════════════════════════════════════════════════════════════════════════════
# TEST 5 : RATE LIMIT - Est-ce que l'API est réelle ou fake ?
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${C}▸ [5/5] RATE LIMIT & RÉPONSES HTTP${N}"
echo -e "───────────────────────────────────────────────────────────────"

TOTAL=$((TOTAL+1))
RATE=$(curl -s -H "$AUTH" "$API/rate_limit")
REMAINING=$(echo "$RATE" | jq -r '.rate.remaining // "?"')
LIMIT=$(echo "$RATE" | jq -r '.rate.limit // "?"')

if [[ "$LIMIT" == "60" ]] || [[ "$LIMIT" == "5000" ]]; then
    echo -e "  ${G}[OK]${N} Rate limit cohérent : $REMAINING/$LIMIT (API réelle)."
    PASSED=$((PASSED+1))
else
    echo -e "  ${R}[FAIL]${N} Rate limit incohérent : $LIMIT (API fake ?)."
fi

# ═══════════════════════════════════════════════════════════════════════════════
# RAPPORT FINAL
# ═══════════════════════════════════════════════════════════════════════════════
echo -e "\n${M}═══════════════════════════════════════════════════════════════════════${N}"
echo -e "${M}  RAPPORT DE FIABILITÉ DES OUTILS GITHUB${N}"
echo -e "${M}═══════════════════════════════════════════════════════════════════════${N}"

PERCENT=$(( PASSED * 100 / TOTAL ))
echo -e "  Tests réussis : ${G}$PASSED${N} / $TOTAL (${PERCENT}%)"

if [[ $PERCENT -ge 80 ]]; then
    echo -e "  Verdict : ${G}LES OUTILS SONT RÉELS${N}. Les APIs répondent et sont cohérentes."
    echo -e "  ${Y}    Mais 'réel' ne veut pas dire 'efficace'. Un outil peut exister et être mauvais.${N}"
elif [[ $PERCENT -ge 50 ]]; then
    echo -e "  Verdict : ${Y}PARTIELLEMENT RÉELS${N}. Certaines APIs existent, d'autres sont fake ou limitées."
else
    echo -e "  Verdict : ${R}MAJORITAIREMENT FAKE${N}. Les outils ne répondent pas comme documenté."
fi
echo -e "${M}═══════════════════════════════════════════════════════════════════════${N}"
